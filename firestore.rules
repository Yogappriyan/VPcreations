rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Public portfolio collections: readable by anyone, writable only by admin
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experience/{expId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquiries: Any visitor can submit, but only authenticated admin can read, modify or delete
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string 
                    && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
